# LLM Wiki Server Configuration
# Copy this to .env and fill in your values

# ── Server ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Wiki Data Storage ────────────────────────────────────
# Root directory where all wiki projects are stored
WIKI_DATA_PATH=/opt/llm-wiki/data

# ── Frontend Static Files ────────────────────────────────
# Directory containing the built React app (npm run build)
STATIC_DIR=/opt/llm-wiki/dist

# ── Logging ──────────────────────────────────────────────
RUST_LOG=llm_wiki_server=info,tower_http=warn
