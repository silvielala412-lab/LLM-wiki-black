# Copy this file to .env and replace the required values.
HOST_PORT=8231
RUST_LOG=llm_wiki_server=info,tower_http=warn

# Required: OpenAI-compatible /v1 endpoint.
LLM_PROVIDER=custom
LLM_ENDPOINT=http://YOUR_LLM_HOST:PORT/v1
LLM_API_KEY=REPLACE_ME
LLM_MODEL=REPLACE_ME
LLM_API_MODE=chat_completions
LLM_MAX_CONTEXT=128000

# Optional: OpenAI-compatible vision endpoint.
VISION_ENDPOINT=
VISION_MODEL=
VISION_API_KEY=

# Optional: keyless intranet multimodal OCR endpoint.
OCR_ENDPOINT=
OCR_USER_TEXT=识别文件中的所有文字
OCR_ACTION_SCENARIO=111
PDF_DPI=150
PDF_OCR_MODE=auto

# Optional: embedding endpoint. Use an address reachable from the container.
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Keep model endpoints and keys managed by the server in intranet deployments.
SERVER_CONFIG_LOCKED=true
